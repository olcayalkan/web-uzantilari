{
  "manifest_version": 3,
  "name": "Oto Çevirmen — Seçileni Türkçeye Çevir",
  "version": "1.1.1",
  "description": "Sayfada seçtiğin metni otomatik algılanan dilden Türkçeye çevirir ve seçimin altında küçük bir balonda gösterir.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "action": {
    "default_popup": "src/features/ceviri/presentation/popup/popup.html",
    "default_title": "Oto Çevirmen"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/core/sabitler.js",
        "src/features/ceviri/data/depolama.js",
        "src/features/ceviri/domain/ceviri_motoru.js",
        "src/features/ceviri/presentation/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "secimi-cevir": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" },
      "description": "Seçili metni Türkçeye çevir (otomatik mod kapalıyken de çalışır)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
