{
  "manifest_version": 3,
  "name": "Oto Çözücü — Kodlama Tanıma & Decode",
  "version": "1.3.0",
  "description": "Kodlanmış/şifreli metni otomatik tanıyıp çözer ve kodlar (Base64, Hex, Base58/85/91, Morse, Vigenère, Playfair, Bifid, XOR, JWT, hash tanıma...).",
  "permissions": ["contextMenus", "clipboardRead", "storage", "notifications"],
  "action": {
    "default_popup": "src/features/cozucu/presentation/popup/popup.html",
    "default_title": "Oto Çözücü"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/features/cozucu/domain/cozucu_motoru.js",
        "src/core/sabitler.js",
        "src/features/cozucu/data/depolama.js",
        "src/features/cozucu/presentation/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
